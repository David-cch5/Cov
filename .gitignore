# Covenant source data -- inputs, never modified by the app, not tracked in git
/[0-9]*/
/_textcache/
/_textcache_v2/
/_textcache_final/
/_ocr2_work/
/_ocr_escalated/
/Covenant_Matrix/
/Covenant_Matrix_SAMPLE/
/_pilot/
Covenant_App_Management_Brief.*
.~lock.*

# Postgres cluster (local dev data directory)
/.pgdata/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Secrets / local config
.env
*.local.env
.claude/settings.local.json

# OS cruft
.DS_Store

# Editor / temp
*.tmp

# Generated formation maps -- rebuilt by the publish_map pipeline stage from the
# database, so they are output rather than source. _dropbox/_intake hold dropped
# documents and their acquired text, which are data, not code.
_artifacts/
_dropbox/
_intake/
_intake_text/

# _corrected_text/ is deliberately NOT ignored, though it was at first, grouped
# with the acquired text above. That was a misreading of what it holds. The text
# caches are machine readings that re-derive from the same scan on every run, so
# losing one costs a re-run; a correction is a HUMAN VERDICT about which reading
# is right and on what evidence, and nothing regenerates it. It was the one
# artifact here that could not be rebuilt and the one artifact not backed up.
