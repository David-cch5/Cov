# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg2://postgres@localhost:5544/covenant_db
DB_SCHEMA=covenant

ANTHROPIC_API_KEY=

# Model routing (see CLAUDE.md) -- overridable per environment, these are the defaults
LLM_MODEL_DEFAULT=claude-sonnet-5
LLM_MODEL_HARD=claude-opus-4-8
LLM_MODEL_HARDEST=claude-fable-5
LLM_MODEL_TRIVIAL=claude-haiku-4-5-20251001

OBJECT_STORAGE_ROOT=./_object_store

# Recorder-portal login, by VENDOR not by county: one GovOS PublicSearch account
# covers every *.publicsearch.us county (Collin, Denton, Montgomery, Nueces).
# Needed only to retrieve DOCUMENT IMAGES -- searching works as a guest.
PUBLICSEARCH_USERNAME=
PUBLICSEARCH_PASSWORD=
